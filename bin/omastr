#!/bin/bash
#
# omastr — keyring-backed Nostr identity core for Omarchy.
#
# The nsec lives in the Secret Service keyring (gnome-keyring) and is only
# ever handed to child processes via the environment, never argv, never disk.
# Every other piece of the lemon.omastr plugin (notifications daemon, wall,
# app catalog, signer) is a thin client of this script.

set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omastr"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omastr"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omastr"
CONFIG_FILE="$CONFIG_DIR/config.json"
WALL_FILE="$CONFIG_DIR/wall.json"
HICOLOR_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"

# NIP-89 app store constants, mirroring Din/NostrHub.
APP_HANDLER_KIND=31990
FEATURED_PACK_PUBKEY=932614571afcbad4d17a191ee281e39eebbb41b93fac8fd87829622aeb112f4d
FEATURED_PACK_D=k4p5w0n22suf
# Relays cap recency queries; many listings only surface by category tag.
APP_CATEGORY_TAGS=(social tools video pictures marketplace music podcast
  communities messaging dvm fitness productivity education image todo
  rideshare ditto mkstack relay nostr chat news article blog media images
  hosting code pastebin storage blossom upload tool zaps goals gigs bounties
  escrow freelance bunker desktop ephemeral password-manager)

# Attributes identifying our secret in the keyring.
SECRET_ATTRS=(service omastr key nsec)
LEGACY_SECRET_ATTRS=(service omarchy-nostr key nsec)

# Relays likely to carry anyone's kind 10002 relay list.
BOOTSTRAP_RELAYS=(wss://purplepag.es wss://relay.primal.net wss://nos.lol wss://relay.damus.io)

# Fallback relay list when the user has no published kind 10002.
DEFAULT_RELAYS='[
  {"url":"wss://relay.damus.io","read":true,"write":true},
  {"url":"wss://relay.primal.net","read":true,"write":true},
  {"url":"wss://nos.lol","read":true,"write":true}
]'

fail() {
  echo "omastr: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: omastr <command> [args]

Commands:
  setup [--from-env] [--yes]   Store your nsec in the keyring and build config
  status [--quiet] [--network] Health check (deps, key, config[, relay reach])
  pubkey [--npub]              Print your public key (hex, or npub)
  relays [read|write]          Print configured relay URLs, one per line
  req <nak-req-args>           nak req with your read relays + NIP-42 auth
  sign                         Sign a (partial) event JSON from stdin
  publish                      Sign stdin event and send to your write relays
  encrypt|decrypt <nak-args>   nak encrypt/decrypt with your key (-p <pubkey>)
  run [--var NAME] -- <cmd>    Run a command with the nsec in its environment
                               (NAME defaults to NSEC; e.g. shakespeare deploy)
  catalog [--json]             Browse NIP-89 app listings and install to the wall
  wall add <name> <url> [icon] Install a web app + put its tile on the wall
  wall remove <name>           Take a tile off the wall
  wall list                    Print the wall's tiles
  uninstall [--yes]            Remove key from keyring + all config/state/cache

The key is fetched from the Secret Service keyring on demand and passed to
child processes only via the environment. No command ever prints it.
EOF
}

# One-time move from the pre-rename layout (omarchy-nostr → omastr). Gated on
# the old config dir so steady-state invocations pay no cost.
migrate_legacy() {
  local old_config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-nostr"
  [[ -d $old_config ]] || return 0
  local old_state="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-nostr"
  local old_cache="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-nostr"
  [[ -d $CONFIG_DIR ]] || mv "$old_config" "$CONFIG_DIR"
  [[ -d $old_config ]] && rm -rf "$old_config"
  [[ -d $old_state && ! -d $STATE_DIR ]] && mv "$old_state" "$STATE_DIR"
  [[ -d $old_cache && ! -d $CACHE_DIR ]] && mv "$old_cache" "$CACHE_DIR"
  local old_secret
  old_secret="$(secret-tool lookup "${LEGACY_SECRET_ATTRS[@]}" 2>/dev/null)" || true
  if [[ -n $old_secret ]] && ! have_secret; then
    printf '%s' "$old_secret" | secret-tool store --label="Omastr Nostr key" "${SECRET_ATTRS[@]}"
    secret-tool clear "${LEGACY_SECRET_ATTRS[@]}" 2>/dev/null || true
  fi
  unset old_secret
  [[ -L $HOME/.local/bin/omarchy-nostr ]] && rm -f "$HOME/.local/bin/omarchy-nostr"
  echo "omastr: migrated omarchy-nostr config/key to the new name" >&2
}

have() { command -v "$1" >/dev/null 2>&1; }

require_deps() {
  local missing=()
  for dep in "$@"; do have "$dep" || missing+=("$dep"); done
  if ((${#missing[@]})); then
    fail "missing dependencies: ${missing[*]} (nak: https://github.com/fiatjaf/nak — try 'omarchy pkg aur add nak' or 'go install github.com/fiatjaf/nak@latest')"
  fi
}

fetch_secret() {
  secret-tool lookup "${SECRET_ATTRS[@]}" 2>/dev/null
}

have_secret() {
  local s
  s="$(fetch_secret)" && [[ -n $s ]]
}

require_config() {
  [[ -s $CONFIG_FILE ]] || fail "no config at $CONFIG_FILE — run: omastr setup"
}

config_pubkey() {
  require_config
  jq -re '.pubkey' "$CONFIG_FILE" 2>/dev/null || fail "config has no pubkey — re-run setup"
}

config_relays() {
  # $1: read|write|all — prints one URL per line
  require_config
  case "${1:-all}" in
  read) jq -r '.relays[] | select(.read) | .url' "$CONFIG_FILE" ;;
  write) jq -r '.relays[] | select(.write) | .url' "$CONFIG_FILE" ;;
  all) jq -r '.relays[].url' "$CONFIG_FILE" ;;
  *) fail "relays: expected read|write" ;;
  esac
}

# Run nak with the keyring secret in NOSTR_SECRET_KEY. The env var exists only
# on the child process; this script's own environment stays clean.
nak_with_key() {
  local secret
  secret="$(fetch_secret)"
  [[ -n $secret ]] || fail "no key in keyring — run: omastr setup"
  NOSTR_SECRET_KEY="$secret" nak "$@"
}

# ---------------------------------------------------------------------------
# setup
# ---------------------------------------------------------------------------

fetch_relay_list() {
  # $1: hex pubkey — prints a JSON array of {url,read,write}, or nothing
  local event
  event="$(nak req -k 10002 -a "$1" -l 1 "${BOOTSTRAP_RELAYS[@]}" 2>/dev/null |
    jq -cs 'map(select(.kind == 10002)) | max_by(.created_at) // empty')" || true
  [[ -n $event ]] || return 1
  jq -c '[.tags[] | select(.[0] == "r") | {
    url: .[1],
    read: ((.[2] // "") == "" or .[2] == "read"),
    write: ((.[2] // "") == "" or .[2] == "write")
  }] | map(select(.url | startswith("wss://") or startswith("ws://")))' <<<"$event"
}

cmd_setup() {
  local from_env=0 assume_yes=0
  for arg in "$@"; do
    case "$arg" in
    --from-env) from_env=1 ;;
    --yes | -y) assume_yes=1 ;;
    *) fail "setup: unknown option $arg" ;;
    esac
  done

  require_deps nak secret-tool jq
  ((assume_yes)) || require_deps gum

  if have_secret; then
    if ((assume_yes)); then
      echo "A key is already stored; replacing it."
    else
      gum confirm "A Nostr key is already stored in the keyring. Replace it?" || {
        echo "Keeping the existing key."
        exit 0
      }
    fi
  fi

  local nsec=""
  if [[ -n ${NSEC:-} ]] && { ((from_env)) || ((assume_yes)) ||
    gum confirm "Found \$NSEC in your environment. Import that key?"; }; then
    nsec="$NSEC"
  else
    ((assume_yes)) && fail "setup --yes needs \$NSEC set (or run interactively)"
    nsec="$(gum input --password --placeholder 'nsec1...' --header 'Paste your Nostr secret key')"
  fi
  [[ -n $nsec ]] || fail "no key provided"
  [[ $nsec == nsec1* ]] || fail "key must be in nsec1... format"

  # Validate by deriving the pubkey (secret via stdin, never argv).
  local pubkey
  pubkey="$(printf '%s\n' "$nsec" | nak key public 2>/dev/null)" || true
  [[ $pubkey =~ ^[0-9a-f]{64}$ ]] || fail "that nsec is not a valid key"
  local npub
  npub="$(nak encode npub "$pubkey")"

  printf '%s' "$nsec" | secret-tool store --label="Omastr Nostr key ($npub)" "${SECRET_ATTRS[@]}"
  unset nsec
  echo "Key stored in keyring for $npub"

  mkdir -p "$CONFIG_DIR" "$STATE_DIR" "$CACHE_DIR"

  echo "Fetching your relay list (kind 10002)..."
  local relays
  if relays="$(fetch_relay_list "$pubkey")" && [[ $(jq 'length' <<<"$relays") -gt 0 ]]; then
    echo "Found $(jq 'length' <<<"$relays") relays from your published list."
  else
    relays="$(jq -c . <<<"$DEFAULT_RELAYS")"
    echo "No published relay list found; using defaults (edit $CONFIG_FILE to change)."
  fi

  jq -n --arg pubkey "$pubkey" --arg npub "$npub" --argjson relays "$relays" \
    '{pubkey: $pubkey, npub: $npub, relays: $relays, updatedAt: now | floor}' >"$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
  echo "Config written to $CONFIG_FILE"

  # Make the CLI reachable as plain `omastr` (plugins can't touch PATH).
  if [[ -d $HOME/.local/bin && $SELF != "$HOME/.local/bin/omastr" ]]; then
    ln -sf "$SELF" "$HOME/.local/bin/omastr"
    echo "Symlinked to ~/.local/bin/omastr"
  fi

  cat <<EOF

Done. Next steps:
  - Remove 'export NSEC=...' from your shell config (~/.bashrc) — this tool
    replaces it. Tools that still need the raw key can use:
      omastr run -- <command>            # sets NSEC for that command only
      omastr run --var NOSTR_SECRET_KEY -- <command>
  - Shakespeare deploys become:
      omastr run -- npx -y @shakespeare.diy/cli deploy <subdomain>
  - Check health any time with: omastr status
EOF
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

cmd_status() {
  local quiet=0 network=0
  for arg in "$@"; do
    case "$arg" in
    --quiet | -q) quiet=1 ;;
    --network) network=1 ;;
    *) fail "status: unknown option $arg" ;;
    esac
  done

  local ok=0
  check() {
    # $1: label, $2: 0/1 pass
    if (($2)); then
      ((quiet)) || echo "  ok: $1"
    else
      ok=1
      ((quiet)) || echo "MISSING: $1"
    fi
  }

  local dep_ok=1
  for dep in nak secret-tool jq gum; do
    have "$dep" || dep_ok=0
  done
  check "dependencies (nak secret-tool jq gum)" "$dep_ok"

  local key_ok=0
  have_secret && key_ok=1
  check "key in keyring" "$key_ok"

  local cfg_ok=0
  [[ -s $CONFIG_FILE ]] && jq -e '.pubkey and (.relays | length > 0)' "$CONFIG_FILE" >/dev/null 2>&1 && cfg_ok=1
  check "config ($CONFIG_FILE)" "$cfg_ok"

  if ((network)) && ((cfg_ok)); then
    local relay reach_ok=0
    relay="$(config_relays read | head -1)"
    if [[ -n $relay ]] && nak relay "$relay" >/dev/null 2>&1; then reach_ok=1; fi
    check "relay reachable ($relay)" "$reach_ok"
  fi

  if ((ok == 0)) && ((quiet == 0)); then
    echo "healthy — $(jq -r '.npub' "$CONFIG_FILE" 2>/dev/null || echo '?')"
  fi
  exit "$ok"
}

# ---------------------------------------------------------------------------
# read/key-side commands
# ---------------------------------------------------------------------------

cmd_pubkey() {
  require_config
  if [[ ${1:-} == --npub ]]; then
    jq -re '.npub' "$CONFIG_FILE"
  else
    config_pubkey
  fi
}

cmd_req() {
  require_deps nak jq
  # If the caller supplied relay URLs, respect them; otherwise append read relays.
  local has_relay=0
  for arg in "$@"; do
    [[ $arg == ws://* || $arg == wss://* ]] && has_relay=1
  done
  local relays=()
  if ((has_relay == 0)); then
    mapfile -t relays < <(config_relays read)
    ((${#relays[@]})) || fail "no read relays configured"
  fi
  if have_secret; then
    # --auth: some relays silently withhold events without NIP-42.
    nak_with_key req --auth "$@" "${relays[@]}"
  else
    nak req "$@" "${relays[@]}"
  fi
}

cmd_sign() {
  require_deps nak
  nak_with_key event
}

cmd_publish() {
  require_deps nak jq
  local relays=()
  mapfile -t relays < <(config_relays write)
  ((${#relays[@]})) || fail "no write relays configured"
  nak_with_key event --auth "${relays[@]}"
}

cmd_encrypt() { require_deps nak && nak_with_key encrypt "$@"; }
cmd_decrypt() { require_deps nak && nak_with_key decrypt "$@"; }

cmd_run() {
  local var="NSEC"
  while (($# > 0)); do
    case "$1" in
    --var)
      var="${2:?--var needs a name}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *) break ;;
    esac
  done
  (($# > 0)) || fail "run: no command given (usage: omastr run [--var NAME] -- <cmd...>)"
  [[ $var =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || fail "run: invalid variable name '$var'"
  local secret
  secret="$(fetch_secret)"
  [[ -n $secret ]] || fail "no key in keyring — run: omastr setup"
  exec env "$var=$secret" "$@"
}

# ---------------------------------------------------------------------------
# the wall — tiles for installed Nostr apps, drawn by Wall.qml
# ---------------------------------------------------------------------------

# Must mirror omarchy-webapp-install's safe_icon_name so the icon path we put
# in wall.json is the file the installer actually wrote.
slugify() {
  printf '%s\n' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//'
}

ensure_wall() {
  mkdir -p "$CONFIG_DIR"
  [[ -s $WALL_FILE ]] || echo '[]' >"$WALL_FILE"
}

cmd_wall_add() {
  local name="${1:-}" url="${2:-}" icon="${3:-}"
  [[ -n $name && -n $url ]] || fail "usage: omastr wall add <name> <url> [icon-url]"
  [[ $name == */* ]] && fail "name cannot contain '/'"
  require_deps jq
  have omarchy-webapp-install || fail "omarchy-webapp-install not found — is this an Omarchy system?"

  # The stock installer fetches/installs the icon and writes the .desktop
  # launcher entry; the wall tile then reuses the exact icon file it wrote.
  omarchy-webapp-install "$name" "$url" "$icon"

  local slug icon_path
  slug="$(slugify "$name")"
  icon_path="$HICOLOR_DIR/$slug.png"
  [[ -f $icon_path ]] || icon_path=""

  ensure_wall
  local tmp
  tmp="$(mktemp "$CONFIG_DIR/.wall.XXXXXX")"
  jq --arg id "$slug" --arg name "$name" --arg url "$url" --arg icon "$icon_path" '
    map(select(.id != $id and (((.exec // []) | index($url)) | not)))
    + [{id: $id, name: $name,
        icon: (if $icon == "" then null else $icon end),
        exec: ["omarchy-launch-webapp", $url]}]
  ' "$WALL_FILE" >"$tmp" && mv "$tmp" "$WALL_FILE"
  echo "On the wall: $name → $url"
}

cmd_wall_remove() {
  local name="${1:-}"
  [[ -n $name ]] || fail "usage: omastr wall remove <name>"
  require_deps jq
  ensure_wall
  local slug tmp
  slug="$(slugify "$name")"
  tmp="$(mktemp "$CONFIG_DIR/.wall.XXXXXX")"
  jq --arg id "$slug" --arg name "$name" \
    'map(select(.id != $id and .name != $name))' "$WALL_FILE" >"$tmp" && mv "$tmp" "$WALL_FILE"
  echo "Off the wall: $name"
  echo "(Launcher entry stays; remove it with: omarchy-webapp-remove \"$name\")"
}

cmd_wall_list() {
  require_deps jq
  ensure_wall
  jq -r 'to_entries[] | "\(.key + 1)\t\(.value.name)\t\(.value.exec | join(" "))"' "$WALL_FILE"
}

# ---------------------------------------------------------------------------
# catalog — browse NIP-89 (kind 31990) app listings and install to the wall
# ---------------------------------------------------------------------------

fetch_catalog() {
  # Writes parsed catalog JSON to $CACHE_DIR/catalog.json; echoes app count.
  mkdir -p "$CACHE_DIR"
  local relays=()
  mapfile -t relays < <(config_relays read)
  ((${#relays[@]})) || fail "no read relays configured — run: omastr setup"

  local events="$CACHE_DIR/catalog-events.jsonl"
  local tagargs=()
  for t in "${APP_CATEGORY_TAGS[@]}"; do tagargs+=(-t "t=$t"); done
  {
    # Two REQs, per Din: a plain recency scan plus a category-tag scan, since
    # relays cap recency queries and many listings only surface by category.
    nak req -k "$APP_HANDLER_KIND" -l 100 "${relays[@]}" 2>/dev/null || true
    nak req -k "$APP_HANDLER_KIND" -l 100 "${tagargs[@]}" "${relays[@]}" 2>/dev/null || true
  } >"$events"

  # Featured = members of the Team Soapbox follow pack (kind 39089).
  local featured
  featured="$(nak req -k 39089 -a "$FEATURED_PACK_PUBKEY" -d "$FEATURED_PACK_D" -l 1 "${relays[@]}" 2>/dev/null |
    jq -cs 'map(select(.kind == 39089)) | max_by(.created_at)
      | (.tags // []) | map(select(.[0] == "p" and (.[1] | test("^[0-9a-f]{64}$")))) | map(.[1])' 2>/dev/null)" || true
  [[ -n $featured && $featured != null ]] || featured='[]'

  # Din's parsing rules: d tag required; name/about/picture/website all
  # required from content JSON; https-only URLs; latest revision per
  # (pubkey, d); featured first, then newest.
  jq -cs --argjson featured "$featured" '
    [ .[]
      | select(.kind == '"$APP_HANDLER_KIND"')
      | . as $e
      | ([$e.tags[] | select(.[0] == "d")][0][1] // null) as $d
      | select($d != null and $d != "")
      | (try ($e.content | fromjson) catch null) as $m
      | select(($m | type) == "object")
      | {addr: "\($e.pubkey):\($d)",
         created_at: $e.created_at,
         pubkey: $e.pubkey,
         name: ((($m.name // $m.display_name // "") | tostring) | gsub("^\\s+|\\s+$"; "")),
         about: ((($m.about // "") | tostring) | gsub("\\s+"; " ") | gsub("^ | $"; "")),
         picture: (($m.picture // "") | tostring),
         website: (($m.website // "") | tostring)}
      | select(.name != "" and .about != "" and .picture != "" and .website != "")
      | select(.website | test("^https://"))
      | select(.picture | test("^https://"))
      | .featured = ((.pubkey as $p | $featured | index($p)) != null)
    ]
    | group_by(.addr) | map(max_by(.created_at))
    | sort_by([(if .featured then 0 else 1 end), -.created_at])
  ' "$events" >"$CACHE_DIR/catalog.json"

  enrich_catalog "${relays[@]}"
  jq 'length' "$CACHE_DIR/catalog.json"
}

enrich_catalog() {
  # Adds publisher identity to each catalog entry: name/picture from the
  # publisher's kind 0, npub, and whether the user's kind 3 follows them.
  # Best-effort — a slow relay degrades to empty names, never a failed fetch.
  local relays=("$@")
  local catalog="$CACHE_DIR/catalog.json"
  local pubkeys=()
  mapfile -t pubkeys < <(jq -r '.[].pubkey' "$catalog" | sort -u)
  ((${#pubkeys[@]})) || return 0

  local authargs=()
  for p in "${pubkeys[@]}"; do authargs+=(-a "$p"); done
  local profiles
  profiles="$(nak req -k 0 "${authargs[@]}" "${relays[@]}" 2>/dev/null |
    jq -cs 'map(select(.kind == 0))
      | group_by(.pubkey) | map(max_by(.created_at))
      | map({key: .pubkey,
             value: ((try (.content | fromjson) catch {}) as $m
               | {name: ((($m.display_name // $m.name // "") | tostring) | gsub("^\\s+|\\s+$"; "")),
                  picture: (($m.picture // "") | tostring)})})
      | from_entries' 2>/dev/null)" || true
  [[ -n $profiles && $profiles != null ]] || profiles='{}'

  local follows
  follows="$(nak req -k 3 -a "$(config_pubkey)" -l 1 "${relays[@]}" 2>/dev/null |
    jq -cs 'map(select(.kind == 3)) | max_by(.created_at)
      | (.tags // []) | map(select(.[0] == "p" and (.[1] | test("^[0-9a-f]{64}$")))) | map(.[1])' 2>/dev/null)" || true
  [[ -n $follows && $follows != null ]] || follows='[]'

  local npubs
  npubs="$(paste -d' ' <(printf '%s\n' "${pubkeys[@]}") \
    <(printf '%s\n' "${pubkeys[@]}" | nak encode npub 2>/dev/null) |
    jq -Rn '[inputs | split(" ") | select(length == 2) | {key: .[0], value: .[1]}] | from_entries' 2>/dev/null)" || true
  [[ -n $npubs && $npubs != null ]] || npubs='{}'

  local tmp
  tmp="$(mktemp "$CACHE_DIR/.catalog.XXXXXX")"
  jq -c --argjson profiles "$profiles" --argjson follows "$follows" --argjson npubs "$npubs" '
    map(. + {
      publisher_name: ($profiles[.pubkey].name // ""),
      publisher_picture: (($profiles[.pubkey].picture // "") | if test("^https://") then . else "" end),
      npub: ($npubs[.pubkey] // .pubkey),
      followed: (.pubkey as $pk | ($follows | index($pk)) != null)
    })
  ' "$catalog" >"$tmp" && mv "$tmp" "$catalog"
}

cmd_catalog() {
  if [[ ${1:-} == --json ]]; then
    require_deps nak jq
    fetch_catalog >/dev/null
    cat "$CACHE_DIR/catalog.json"
    return
  fi
  require_deps nak jq gum

  echo "Fetching app catalog from your relays..."
  local count
  count="$(fetch_catalog)"
  ((count > 0)) || fail "no installable listings found (relays may be slow — try again)"
  echo "$count apps."

  local catalog="$CACHE_DIR/catalog.json"
  while true; do
    local pick idx app name about website picture pubkey npub
    pick="$(jq -r 'to_entries[]
      | "\(.key)\t\(if .value.featured then "★" else " " end)\(if .value.followed then "✓" else " " end) \(.value.name) — \(.value.about | .[0:80])\(if .value.publisher_name != "" then "  · " + .value.publisher_name else "" end)"' \
      "$catalog" | gum filter --placeholder "Search apps…  (enter installs, esc quits)" --height 20)" || break
    idx="${pick%%$'\t'*}"
    app="$(jq -c ".[$idx]" "$catalog")"
    name="$(jq -r '.name' <<<"$app")"
    about="$(jq -r '.about' <<<"$app")"
    website="$(jq -r '.website' <<<"$app")"
    picture="$(jq -r '.picture' <<<"$app")"
    npub="$(jq -r '.npub' <<<"$app")"
    local publisher byline
    publisher="$(jq -r 'if .publisher_name != "" then .publisher_name else "" end' <<<"$app")"
    byline="by ${publisher:+$publisher }(${npub:0:16}…)"
    [[ "$(jq -r '.followed' <<<"$app")" == true ]] && byline="$byline — you follow them ✓"

    gum style --border rounded --padding "1 2" --margin "1 0" \
      "$name" "" "$about" "" "→ $website" "$byline"
    if gum confirm "Add $name to the wall?"; then
      cmd_wall_add "$name" "$website" "$picture" || echo "Install failed — back to the list."
    fi
  done
}

cmd_uninstall() {
  local assume_yes=0
  [[ ${1:-} == --yes || ${1:-} == -y ]] && assume_yes=1
  if ((assume_yes == 0)); then
    require_deps gum
    gum confirm "Remove the Nostr key from the keyring and delete all omastr config/state/cache?" || exit 0
  fi
  secret-tool clear "${SECRET_ATTRS[@]}" 2>/dev/null || true
  rm -rf "$CONFIG_DIR" "$STATE_DIR" "$CACHE_DIR"
  [[ -L $HOME/.local/bin/omastr ]] && rm -f "$HOME/.local/bin/omastr"
  [[ -L $HOME/.local/bin/omarchy-nostr ]] && rm -f "$HOME/.local/bin/omarchy-nostr" || true
  echo "Removed. (The plugin itself: omarchy plugin remove lemon.omastr)"
}

# ---------------------------------------------------------------------------

migrate_legacy

cmd="${1:-}"
shift || true
case "$cmd" in
setup) cmd_setup "$@" ;;
status) cmd_status "$@" ;;
pubkey) cmd_pubkey "$@" ;;
relays) config_relays "${1:-all}" ;;
req) cmd_req "$@" ;;
sign) cmd_sign "$@" ;;
publish) cmd_publish "$@" ;;
encrypt) cmd_encrypt "$@" ;;
decrypt) cmd_decrypt "$@" ;;
run | exec) cmd_run "$@" ;;
wall)
  sub="${1:-list}"
  shift || true
  case "$sub" in
  add) cmd_wall_add "$@" ;;
  remove | rm) cmd_wall_remove "$@" ;;
  list | ls) cmd_wall_list ;;
  *) fail "wall: unknown subcommand '$sub' (add|remove|list)" ;;
  esac
  ;;
catalog) cmd_catalog "$@" ;;
uninstall) cmd_uninstall "$@" ;;
"" | -h | --help | help) usage ;;
*)
  usage >&2
  fail "unknown command: $cmd"
  ;;
esac
